--- a/backend/engine_service.py
+++ b/backend/engine_service.py
@@ -104,3 +104,293 @@ def evaluate_candidate(jd_path: Path, cv_path: Path, approved: dict, job_setting
     return (response,candidate,
         [asdict(s) if hasattr(s,'__dataclass_fields__') else s for s in segments],
