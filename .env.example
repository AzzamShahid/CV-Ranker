# Copy to .env, set the two models ONCE here, then choose Cloud or Local in the UI.
# Never share or commit .env. The provider below is the INITIAL UI choice only.
CVR_LLM_PROVIDER=openrouter

# Access policy: local allows only a loopback server bind.
# For managed remote access use oidc and an explicit allowlist; see docs/PRODUCTION_SECURITY.md.
CVR_ACCESS_MODE=local
# CVR_ALLOWED_EMAILS=reviewer1@example.com,reviewer2@example.com

# Cloud assessment: OpenRouter. Required only when Cloud is selected.
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY_HERE
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Local assessment: Ollama, running on your computer.
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# The optional EmbeddingGemma 2 capability cross-check still needs local Ollama,
# even when the assessment LLM is OpenRouter.
EMBEDDING_MODEL=embeddinggemma-2:latest
EMBEDDING_TIMEOUT_SECONDS=180
EMBEDDING_BATCH_SIZE=16

# Polite cloud pacing and bounded retry for HTTP 429 / temporary outages.
# Retries can wait up to the provider's Retry-After hint (capped below).
OPENROUTER_REQUEST_INTERVAL_SECONDS=6
OPENROUTER_RETRY_DELAY_SECONDS=5
OPENROUTER_MAX_RETRY_AFTER_SECONDS=45
OPENROUTER_MAX_REQUESTS_PER_RUN=0
# Maximum actual OpenRouter HTTP attempts for one approved JD/CV checkpoint,
# including later Resume attempts. Raising it may incur extra provider costs.
# A source-validation/no-progress pause is NOT the same as an exhausted budget.
# Keep a finite ceiling; increase this value only when actual usage reaches it
# and extra provider spending has been explicitly approved.
OPENROUTER_MAX_REQUESTS_PER_ASSESSMENT=128
